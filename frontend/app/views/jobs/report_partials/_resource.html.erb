<div class="form-group required">
  <div class="input-group linker-wrapper">
    <input type="text" class="linker"
           id="report_resource_linker"
           data-label_browse="Browse Resources"
           data-label_link="Select Resource"
           data-path="<%= form.path %>"
           data-name="resource_ref"
           data-url="<%= url_for :controller => :search, :action => :do_search, :format => :json %>"
           data-browse-url="<%= url_for :controller => :search, :action => :do_search, :format => :js %>"
           data-selected="[]"
           data-format_property="display_string"
           data-multiplicity="one"
           data-types='["resource"]'
           aria-label="Select resource to report on"
      />

    <div class="input-group-append">
      <button
        type="button"
        class="btn btn-default dropdown-toggle"
        data-toggle="dropdown"
        aria-expanded="false"
        aria-label="Select resource to report on"
      ></button>
      <ul class="dropdown-menu">
        <li>
          <button
            type="button"
            class="btn btn-sm rounded-0 dropdown-item linker-browse-btn"
            aria-label="Browse resources"
          ><%= t("actions.browse") %></button>
        </li>
      </ul>
    </div>
  </div>
</div>