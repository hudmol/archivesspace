<%= setup_context :title => t("navbar.manage_activity_stream") %>

<div class="d-flex">
  <div class="col-md-12">
    <div class="record-toolbar d-flex align-items-center">
    </div>
    <div class="record-pane">
      <h2><%= t("navbar.manage_activity_stream") %></h2>
      <br>
      <%= render_aspace_partial :partial => "shared/flash_messages" %>
      <div class="tabbable">
        <ul class="nav nav-tabs">
          <li class="nav-item"><a class="nav-link" href="<%= url_for(:controller => :activity_stream, :action => :exports) %>"><%= t('activity_stream._frontend.exports_tab') %></a></li>
          <li class="active nav-item"><a class="active nav-link" href="javascript:void(0)"><%= t('activity_stream._frontend.admin_tab') %></a></li>
        </ul>
        <div class="tab-content">
          <div class="tab-pane active">
            <section class="subrecord-form">
                <h3><%= t("activity_stream._frontend.reset_feed") %></h3>
                <div class="subrecord-form-container">
                  <div class="subrecord-form-fields">
                    <%= t("activity_stream._frontend.reset_feed_information") %>
                    <%= form_tag url_for(:controller => :activity_stream, :action => :reset_feed) do %>
                      <div class="form-group w-100 row required">
                        <label class="col-sm-2 control-label text-right" for="object_types">
                          <%= t('activity_stream._frontend.activity_stream_export_criteria.object_types') %>
                        </label>
                        <div class="col-sm-9">
                          <select id="object_types" name="object_type[]" class="form-control" multiple required>
                            <% @object_types.sort.each do |object_type| %>
                              <option value="<%= object_type %>"><%= object_type %></option>
                            <% end %>
                          </select>
                        </div>
                      </div>
                      <div class="form-group w-100 row required">
                        <div class="col-sm-9 offset-sm-2">
                          <button type="submit" class="btn btn-sm btn-danger"><%= t("activity_stream._frontend.reset_feed") %></button>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
            </section>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>