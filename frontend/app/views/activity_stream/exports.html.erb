<%= setup_context :title => t('navbar.manage_activity_stream') %>
<div class="d-flex">
  <div class="col-md-12">
    <div class="record-toolbar d-flex align-items-center">
    </div>
    <div class="record-pane">
      <h2><%= t('navbar.manage_activity_stream') %></h2>

      <br>

      <%= render_aspace_partial :partial => "shared/flash_messages" %>

      <div class="tabbable">
        <ul class="nav nav-tabs">
          <li class="nav-item"><a class="nav-link" href="<%= url_for(:controller => :activity_stream, :action => :index) %>">Administration</a></li>
          <li class="active nav-item"><a class="active nav-link" href="javascript:void(0)">Exports</a></li>
        </ul>
        <div class="tab-content">
          <div class="tab-pane active">
            <br>
            <p><button class="btn btn-default" id="showCreateExportButton">Create Export</button></p>
            <% if @search_data['results'].length %>
              <div class="table-responsive">
                <table class="table table-striped table-bordered table-condensed">
                  <thead>
                    <tr>
                      <th style="width: 280px;">Export Type</th>
                      <th>Criteria</th>
                      <th>Status</th>
                      <th>Created by</th>
                      <th>Created at</th>
                      <th style="width: 120px;"></th>
                    </tr>
                  </thead>
                  <tbody>
                  <% @search_data['results'].each do |export| %>
                    <tr>
                      <td><%= export.export_type.sub('EXPORT_TYPE_', '') %></td>
                      <td>

                        <% export.criteria && export.criteria.each do |key, value| %>
                          <% next if value.empty? || key == 'jsonmodel_type'%>
                          <strong><%= t("activity_stream_export.criteria.#{key}") %>: </strong>
                          <% if key == 'user' %>
                            <%= [value.dig('_resolved', 'username'), value.dig('ref')].compact.join(' - ') %>
                          <% elsif key == 'repository' %>
                            <%= [value.dig('_resolved', 'repo_code'), value.dig('ref')].compact.join(' - ') %>
                          <% elsif key == 'resource' %>
                            <%= [value.dig('_resolved', 'title'), value.dig('ref')].compact.join(' - ') %>
                          <% else %>
                            <%= ASUtils.wrap(value).join(', ') %>
                          <% end %>
                          <br>
                        <% end %>
                      </td>
                      <td><%= export.status.sub('EXPORT_STATUS_', '') %></td>
                      <td><%= export.created_by %></td>
                      <td><%= export.create_time %></td>
                      <td>
                        <% if export.status == 'EXPORT_STATUS_COMPLETE' %>
                          <%= link_to 'Download', url_for(controller: :activity_stream, action: :export_download, id: export.id), class: 'btn btn-sm btn-default' %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <p class="alert alert-info">
                No exports.
              </p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

