<%= setup_context :title => t('navbar.manage_activity_stream') %>
<div class="d-flex">
  <div class="col-md-12">
    <div class="record-toolbar d-flex align-items-center">
    </div>
    <div class="record-pane">
      <h2><%= t('navbar.manage_activity_stream') %></h2>

      <br>

      <%= render_aspace_partial :partial => "shared/flash_messages" %>

      <div class="tabbable">
        <ul class="nav nav-tabs">
          <li class="active nav-item"><a class="active nav-link" href="javascript:void(0)"><%= t('activity_stream._frontend.exports_tab') %></a></li>
          <% if user_can?('manage_activity_stream') %>
          <li class="nav-item"><a class="nav-link" href="<%= url_for(:controller => :activity_stream, :action => :admin) %>"><%= t('activity_stream._frontend.admin_tab') %></a></li>
          <% end %>
        </ul>
        <div class="tab-content">
          <div class="tab-pane active">
            <br>
            <p><button class="btn btn-default" id="showCreateExportButton"><%= t('activity_stream._frontend.action.create_export') %></button></p>
            <% if @search_data['results'].length %>
              <div class="table-responsive">
                <table class="table table-striped table-bordered table-condensed">
                  <thead>
                    <tr>
                      <th style="width: 280px;"><%= t('activity_stream._frontend.export_type') %></th>
                      <th><%= t('activity_stream._frontend.export_criteria') %></th>
                      <th><%= t('activity_stream._frontend.export_status') %></th>
                      <th><%= t('activity_stream._frontend.export_created_by') %></th>
                      <th><%= t('activity_stream._frontend.export_created_at') %></th>
                      <th style="width: 120px;"></th>
                    </tr>
                  </thead>
                  <tbody>
                  <% @search_data['results'].each do |export| %>
                    <tr>
                      <td><%= t("activity_stream._frontend.#{export.export_type.downcase}") %></td>
                      <td>
                        <% export.criteria && export.criteria.each do |key, value| %>
                          <% next if value.empty? || key == 'jsonmodel_type'%>
                          <strong><%= t("activity_stream._frontend.activity_stream_export_criteria.#{key}") %>: </strong>
                          <% if key == 'user' %>
                            <%= [value.dig('_resolved', 'username'), value.dig('ref')].compact.join(' - ') %>
                          <% elsif key == 'repository' %>
                            <%= [value.dig('_resolved', 'repo_code'), value.dig('ref')].compact.join(' - ') %>
                          <% elsif key == 'resource' %>
                            <%= [value.dig('_resolved', 'title'), value.dig('ref')].compact.join(' - ') %>
                          <% else %>
                            <%= ASUtils.wrap(value).join(', ') %>
                          <% end %>
                          <br>
                        <% end %>
                      </td>
                      <td>
                        <%
                          badge_css_class =
                            if export.status == 'EXPORT_STATUS_COMPLETE'
                               'badge-success'
                            elsif export.status == 'EXPORT_STATUS_ERRORED'
                              'badge-danger'
                            else
                              'badge-default'
                            end
                        %>
                        <span class="badge <%= badge_css_class %>">
                          <%= t("activity_stream._frontend.#{export.status.downcase}") %>
                        </span>
                      </td>
                      <td><%= export.created_by %></td>
                      <td><%= Time.parse(export.create_time).getlocal %></td>
                      <td>
                        <% if export.status == 'EXPORT_STATUS_COMPLETE' %>
                          <%= link_to t('activity_stream._frontend.action.download_export'), url_for(controller: :activity_stream, action: :export_download, id: export.id), class: 'btn btn-sm btn-default' %>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                  </tbody>
                </table>
                <%= render partial: 'shared/pagination' %>
              </div>
            <% else %>
              <p class="alert alert-info">
                <%= t('activity_stream._frontend.no_exports') %>
              </p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

